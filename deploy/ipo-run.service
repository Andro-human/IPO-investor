[Unit]
Description=IPO bidder: bid-day decision + apply
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=__ROOT__
ExecStart=__ROOT__/.venv/bin/python -m ipo_bidder run
# retry once if the network or a site was flaky
Restart=on-failure
RestartSec=10min
