[Unit]
Description=IPO bidder: mandate reminders + allotment news
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=__ROOT__
ExecStart=__ROOT__/.venv/bin/python -m ipo_bidder remind
# retry once if the network or a site was flaky
Restart=on-failure
RestartSec=10min
