[Unit]
Description=IPO bidder: listing-day sell
After=network-online.target
Wants=network-online.target
# at most 2 retries (10 min apart) per failure, so a bad day doesn't flood Telegram
StartLimitIntervalSec=1h
StartLimitBurst=3

[Service]
Type=oneshot
WorkingDirectory=__ROOT__
ExecStart=__ROOT__/.venv/bin/python -m ipo_bidder sell
# retry if the network or a site was flaky (capped by StartLimit* above)
Restart=on-failure
RestartSec=10min
